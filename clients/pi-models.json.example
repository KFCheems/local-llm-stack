          "reasoning": false,
          "input": ["text"],
          "contextWindow": 163840,
          "maxTokens": 8192
        },
        {
          "id": "orcasaq-27b",
          "name": "Local 27B (alternate slot)",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 163840,
          "maxTokens": 8192
        }
      ]
    }
  }
}
